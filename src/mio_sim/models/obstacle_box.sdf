<?xml version="1.0"?>
<!-- H2.2: a box that is not on the map. Drop it in the robot's path mid-run:
       ros2 run ros_gz_sim create -name box -file $(ros2 pkg prefix mio_sim)/share/mio_sim/models/obstacle_box.sdf -x 0 -y 0 -z 0.25
     0.5 m tall so it crosses the LiDAR plane (~0.20 m). Static, so a bump cannot push it out of the way. -->
<sdf version="1.9">
  <model name="obstacle_box">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.3 0.3 0.5</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.3 0.3 0.5</size></box></geometry>
        <material><diffuse>0.85 0.35 0.1 1.0</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
