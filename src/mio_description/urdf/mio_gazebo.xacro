<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================== -->
  <!-- Gazebo Physics & Friction Properties       -->
  <!-- ========================================== -->
  <gazebo reference="base_link">
    <material>
      <ambient>0.92 0.93 0.95 1.0</ambient>
      <diffuse>0.92 0.93 0.95 1.0</diffuse>
    </material>
  </gazebo>

  <gazebo reference="left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <material>
      <ambient>0.15 0.15 0.15 1.0</ambient>
      <diffuse>0.15 0.15 0.15 1.0</diffuse>
    </material>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <material>
      <ambient>0.15 0.15 0.15 1.0</ambient>
      <diffuse>0.15 0.15 0.15 1.0</diffuse>
    </material>
  </gazebo>

  <!-- Low friction for casters so they slide smoothly without resisting turning -->
  <gazebo reference="front_caster_link">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <material>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <diffuse>0.6 0.6 0.6 1.0</diffuse>
    </material>
  </gazebo>

  <gazebo reference="rear_caster_link">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <material>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <diffuse>0.6 0.6 0.6 1.0</diffuse>
    </material>
  </gazebo>

  <!-- ========================================== -->
  <!-- Gazebo Jetty Diff-Drive System Plugin      -->
  <!-- ========================================== -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <!-- Wheel Joints -->
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <!-- Kinematics.
           Taken from mio_core.xacro, never retyped. These two numbers are what converts wheel
           rotation into distance, so a copy that drifts from the model does not fail loudly —
           it just makes /odom quietly wrong, which is the exact failure H1.3's "1 m driven ≈
           1.0 m" check exists to catch. -->
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <!-- Limits.
           The acceleration limits are also how hard this drive brakes, and the safety supervisor
           budgets for it: its `brake_ms` is 160, and from a stop command to standstill measured
           98-118 ms at 0.5 m/s and at 2.0 rad/s with these numbers (0.5 / 4.5 and 2.0 / 20 are
           111 and 100 ms; the rest is the bridge and a simulation step). Change them and braking
           has to be measured again (HEART_DECISIONS 47). They were 1.5 and 3.0, which took 333
           and 667 ms to stop: longer than the whole 400 ms promise.

           ponytail: one limit for speeding up and for braking, because that is all this plugin
           has. At 4.5 and 20 the outer wheel of a full-speed turn is asked for 6.5 m/s^2, and a
           step command or a stop there can slip (heading off by up to 1.8 deg in four runs).
           Upgrade: ramp speed increases upstream, in the supervisor or the MCU, and keep this as
           the brake. -->
      <max_linear_acceleration>4.5</max_linear_acceleration>
      <min_linear_acceleration>-4.5</min_linear_acceleration>
      <max_angular_acceleration>20.0</max_angular_acceleration>
      <min_angular_acceleration>-20.0</min_angular_acceleration>
      <max_linear_velocity>0.6</max_linear_velocity>
      <min_linear_velocity>-0.6</min_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <min_angular_velocity>-2.0</min_angular_velocity>

      <!-- Topic Subscriptions & Publishing -->
      <topic>/model/mio/cmd_vel</topic>
      <odom_topic>/model/mio/odometry</odom_topic>
      <tf_topic>/model/mio/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <!-- Joint State Publisher Plugin for wheel rotations -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/model/mio/joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
