<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================== -->
  <!-- Gazebo Physics & Friction Properties       -->
  <!-- ========================================== -->
  <gazebo reference="base_link">
    <material>
      <ambient>0.92 0.93 0.95 1.0</ambient>
      <diffuse>0.92 0.93 0.95 1.0</diffuse>
    </material>
  </gazebo>

  <gazebo reference="left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <material>
      <ambient>0.15 0.15 0.15 1.0</ambient>
      <diffuse>0.15 0.15 0.15 1.0</diffuse>
    </material>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <material>
      <ambient>0.15 0.15 0.15 1.0</ambient>
      <diffuse>0.15 0.15 0.15 1.0</diffuse>
    </material>
  </gazebo>

  <!-- Low friction for casters so they slide smoothly without resisting turning -->
  <gazebo reference="front_caster_link">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <material>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <diffuse>0.6 0.6 0.6 1.0</diffuse>
    </material>
  </gazebo>

  <gazebo reference="rear_caster_link">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <material>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <diffuse>0.6 0.6 0.6 1.0</diffuse>
    </material>
  </gazebo>

  <!-- ========================================== -->
  <!-- Gazebo Jetty Diff-Drive System Plugin      -->
  <!-- ========================================== -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <!-- Wheel Joints -->
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <!-- Kinematics -->
      <wheel_separation>0.20</wheel_separation>
      <wheel_radius>0.033</wheel_radius>

      <!-- Limits -->
      <max_linear_acceleration>1.5</max_linear_acceleration>
      <min_linear_acceleration>-1.5</min_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <min_angular_acceleration>-3.0</min_angular_acceleration>
      <max_linear_velocity>0.6</max_linear_velocity>
      <min_linear_velocity>-0.6</min_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <min_angular_velocity>-2.0</min_angular_velocity>

      <!-- Topic Subscriptions & Publishing -->
      <topic>/model/mio/cmd_vel</topic>
      <odom_topic>/model/mio/odometry</odom_topic>
      <tf_topic>/model/mio/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <!-- Joint State Publisher Plugin for wheel rotations -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/model/mio/joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
