<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================== -->
  <!-- Dimensions & Physical Parameters           -->
  <!-- ========================================== -->
  <xacro:property name="chassis_radius" value="0.12"/>
  <xacro:property name="chassis_height" value="0.16"/>
  <xacro:property name="chassis_mass" value="3.0"/>

  <xacro:property name="wheel_radius" value="0.033"/>
  <xacro:property name="wheel_width" value="0.024"/>
  <xacro:property name="wheel_mass" value="0.15"/>
  <xacro:property name="wheel_separation" value="0.20"/>

  <xacro:property name="caster_radius" value="0.012"/>
  <xacro:property name="caster_mass" value="0.05"/>
  <xacro:property name="caster_offset_x" value="0.085"/>

  <!-- ========================================== -->
  <!-- Base Footprint (Ground plane projection)    -->
  <!-- ========================================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- Position base_link above ground by wheel_radius -->
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ========================================== -->
  <!-- Base Link (Chassis Body Origin)           -->
  <!-- ========================================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${chassis_radius}" length="${chassis_height}"/>
      </geometry>
      <material name="chassis_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${chassis_radius}" length="${chassis_height}"/>
      </geometry>
    </collision>
    <!-- Center of mass slightly low for stability -->
    <inertial>
      <origin xyz="0 0 ${chassis_height / 3.0}" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <inertia ixx="${(chassis_mass/12.0) * (3*chassis_radius*chassis_radius + chassis_height*chassis_height)}" ixy="0.0" ixz="0.0"
               iyy="${(chassis_mass/12.0) * (3*chassis_radius*chassis_radius + chassis_height*chassis_height)}" iyz="0.0"
               izz="${(chassis_mass/2.0) * (chassis_radius*chassis_radius)}"/>
    </inertial>
  </link>

  <!-- ========================================== -->
  <!-- Drive Wheel Macro                          -->
  <!-- ========================================== -->
  <xacro:macro name="drive_wheel" params="prefix y_offset">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="rubber_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${(wheel_mass/12.0) * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}" ixy="0.0" ixz="0.0"
                 iyy="${(wheel_mass/12.0) * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}" iyz="0.0"
                 izz="${(wheel_mass/2.0) * (wheel_radius*wheel_radius)}"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 ${y_offset} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Left and Right Drive Wheels -->
  <xacro:drive_wheel prefix="left" y_offset="${wheel_separation / 2.0}"/>
  <xacro:drive_wheel prefix="right" y_offset="${-wheel_separation / 2.0}"/>

  <!-- ========================================== -->
  <!-- Caster Wheel Macro (Passive Spheres)       -->
  <!-- ========================================== -->
  <xacro:macro name="caster_wheel" params="prefix x_offset">
    <link name="${prefix}_caster_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
        <material name="caster_metal"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${caster_mass}"/>
        <inertia ixx="${(2.0/5.0) * caster_mass * caster_radius * caster_radius}" ixy="0.0" ixz="0.0"
                 iyy="${(2.0/5.0) * caster_mass * caster_radius * caster_radius}" iyz="0.0"
                 izz="${(2.0/5.0) * caster_mass * caster_radius * caster_radius}"/>
      </inertial>
    </link>

    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_caster_link"/>
      <!-- Place caster bottom touching ground: z = -(wheel_radius - caster_radius) -->
      <origin xyz="${x_offset} 0 ${-(wheel_radius - caster_radius)}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- Front and Rear Casters -->
  <xacro:caster_wheel prefix="front" x_offset="${caster_offset_x}"/>
  <xacro:caster_wheel prefix="rear" x_offset="${-caster_offset_x}"/>

</robot>
